{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/katalog/",
      "destination": "/files/nzmo-katalog-2026.pdf",
      "permanent": false
    },
    {
      "source": "/potolki/perforirovannye/",
      "destination": "/potolki/kassetnye/hook-on/#perforatsiya",
      "permanent": false
    },
    {
      "source": "/obekty/angiofarm/",
      "destination": "/obekty/",
      "permanent": false
    },
    {
      "source": "/obekty/ave-vita/",
      "destination": "/obekty/",
      "permanent": false
    },
    {
      "source": "/maf/",
      "destination": "/maf/skulptury/",
      "permanent": true
    },
    {
      "source": "/potolki/grilyato/yacheyka-50/",
      "destination": "/potolki/grilyato/#tipy",
      "permanent": false
    },
    {
      "source": "/potolki/grilyato/yacheyka-75/",
      "destination": "/potolki/grilyato/#tipy",
      "permanent": false
    },
    {
      "source": "/potolki/grilyato/yacheyka-100/",
      "destination": "/potolki/grilyato/#tipy",
      "permanent": false
    },
    {
      "source": "/potolki/grilyato/po-proektu/",
      "destination": "/potolki/grilyato/#tipy",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/files/((?!nzmo-kartochka-predpriyatiya\\.pdf$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/files/nzmo-kartochka-predpriyatiya.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
